# Dependencies — never commit these
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/

# Environment variables — keep secrets out
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editor / OS files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Vite cache
.vite/
*.local

# Backup files created during this project
index.html.bak

# Standalone HTML experiments / generated head files (kept local, not part of the Vite app)
index_head.html
index_head_utf8.html
original-design.html
portfolio.html
portfolio_head.html
portfolio_head_utf8.html
premium.html

# Duplicate .cjs configs (the tracked .js versions are canonical)
postcss.config.cjs
tailwind.config.cjs

# Local QA / debug artifacts — Puppeteer screenshots, dev-server logs, and
# one-off debug probes. Generated while testing; never part of the app.
scripts/qa-shots/
scripts/debug-*.mjs
